# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

      # permission_handler (iOS) compiles each permission behind a macro. Without
      # these, Permission.camera/microphone .request() returns denied WITHOUT ever
      # prompting iOS (no entry appears in Settings). Enable the ones the app uses.
      # NOTE: PERMISSION_LOCATION is intentionally NOT set — the app never uses
      # device geolocation, and compiling it in triggers App Store rejection
      # 90683 (missing NSLocationAlwaysAndWhenInUseUsageDescription).
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end

  # Patch FlutterGeneratedPluginSwiftPackage min iOS to match app target.
  # Flutter's deployment target constant is hardcoded to 13.0 in its SDK
  # (flutter_tools/lib/src/darwin/darwin.dart). A migration exists to bump it
  # to the project's IPHONEOS_DEPLOYMENT_TARGET, but Xcode-only builds skip it.
  # This is a known Flutter bug:
  #   https://github.com/flutter/flutter/issues/162072
  #   https://github.com/flutter/flutter/issues/186804
  # Package.swift is regenerated by Flutter on every pub get, so we patch
  # it here after every pod install to keep the fix.
  swift_package = File.join(
    File.dirname(__FILE__),
    'Flutter', 'ephemeral', 'Packages',
    'FlutterGeneratedPluginSwiftPackage', 'Package.swift',
  )
  if File.exist?(swift_package)
    content = File.read(swift_package)
    patched = content.gsub('.iOS("13.0")', '.iOS("16.0")')
    if content != patched
      File.write(swift_package, patched)
      puts "[Podfile] Patched FlutterGeneratedPluginSwiftPackage min iOS to 16.0"
    end
  end

  # Strip bitcode from the vendored TwilioVideo framework. Apple rejects App
  # Store uploads containing bitcode (error 90482). CocoaPods re-extracts the
  # xcframework on every pod install, so re-strip here each time.
  twilio_bin = File.join(
    File.dirname(__FILE__),
    'Pods', 'TwilioVideo', 'TwilioVideo.xcframework',
    'ios-arm64', 'TwilioVideo.framework', 'TwilioVideo',
  )
  if File.exist?(twilio_bin)
    system('xcrun', 'bitcode_strip', twilio_bin, '-r', '-o', "#{twilio_bin}.stripped")
    if File.exist?("#{twilio_bin}.stripped")
      File.rename("#{twilio_bin}.stripped", twilio_bin)
      puts "[Podfile] Stripped bitcode from TwilioVideo.framework"
    end
  end
end


